# Set a unique secret of at least 32 random bytes for hosted deployments.
JWT_SECRET=

ADMIN_EMAIL=

# SMTP settings are required to send password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_APP_URL=https://auraalarm.onrender.com
