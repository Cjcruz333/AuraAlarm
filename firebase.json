{
  "hosting": {
    "site": "auraalarm",
    "public": "client/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.exe",
      "**/*.dll",
      "**/*.so"
    ],
    "redirects": [
      {
        "source": "/auraalarm.apk",
        "destination": "https://github.com/Cjcruz333/AuraAlarm/raw/main/client/public/auraalarm.apk",
        "type": 302
      },
      {
        "source": "/download/app",
        "destination": "https://github.com/Cjcruz333/AuraAlarm/raw/main/client/public/auraalarm.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/auraalarm.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"auraalarm.apk\""
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
