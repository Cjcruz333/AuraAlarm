<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top Branding / Header -->
    <LinearLayout
        android:id="@+id/top_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ AURAALARM"
            android:textColor="#818CF8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- Center Clock and Alarm Label Section -->
    <LinearLayout
        android:id="@+id/center_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Alarm Label -->
        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wake-Up Call"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Large Digital TextClock -->
        <TextClock
            android:id="@+id/alarm_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Date / Subtitle -->
        <TextClock
            android:id="@+id/alarm_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Motivational prompt -->
        <TextView
            android:id="@+id/alarm_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Dismiss to begin your day or Snooze for 5 minutes"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <!-- Bottom Buttons: Snooze and Dismiss -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_dismiss"
            android:text="DISMISS ALARM"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <!-- Snooze (+5 min) Button -->
        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_snooze"
            android:text="SNOOZE (+5 MIN)"
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null" />

    </LinearLayout>

</RelativeLayout>
